            "answers": {
              "additionalProperties": {
                "discriminator": {
                  "mapping": {
                    "box": "#/$defs/BoxAnswer",
                    "choice": "#/$defs/ChoiceAnswer",
                    "noul": "#/$defs/NoulAnswer",
                    "score": "#/$defs/ScoreAnswer"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/NoulAnswer"
                  },
                  {
                    "$ref": "#/$defs/ChoiceAnswer"
                  },
                  {
                    "$ref": "#/$defs/ScoreAnswer"
                  },
                  {
                    "$ref": "#/$defs/BoxAnswer"
                  }
                ]
              },
              "title": "Answers",
              "type": "object"
            },
            "duration_ms": {
              "description": "Client-measured elapsed milliseconds for SDK setup, image upload, and provider response handling for the entire batch.",
              "minimum": 0,
              "type": "number"
            },
            "model": {
              "title": "Model",
              "type": "string"
            },
            "usage": {
              "$ref": "#/$defs/Usage"
            }
          },
          "required": [
            "model",
            "usage",
            "duration_ms"
          ],
